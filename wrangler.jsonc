{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "novaldi-survey",
  "main": "src/index.tsx",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": {
      "enabled": true
    }
  },
  "routes": [
    {
      "pattern": "survey.novaldi.us",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "novaldi-survey",
      "database_id": "92ea8379-ea25-4f8b-980f-e1ada8c4cc5d",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "SUBMIT_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}
